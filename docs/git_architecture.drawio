        </mxCell>

        <mxCell id="rbScope" value="&lt;b&gt;What a rollback changes&lt;/b&gt;&lt;br&gt;&amp;#10003; job + pipeline definitions&lt;br&gt;&amp;#10003; code in /Workspace/Deployments/dox_training/files&lt;br&gt;&amp;#10003; resources added after prod-A are deleted&lt;br&gt;&lt;br&gt;&lt;b&gt;What it does NOT change&lt;/b&gt;&lt;br&gt;&amp;#10007; table data &#8594; RESTORE TABLE &amp;lt;t&amp;gt; TO VERSION AS OF &amp;lt;n&amp;gt;, or a pipeline full refresh&lt;br&gt;&amp;#10007; UC grants, secrets, GitHub settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="1290" y="1025" width="370" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="rbTags" value="Every prod release has its own tag prod-YYYYMMDD-HHMMSS, so the last good version is always known: git tag --list &amp;quot;prod-*&amp;quot; --sort=-creatordate" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
