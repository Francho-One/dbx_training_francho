<mxfile host="app.diagrams.net">
  <diagram id="dox_training_git" name="dox_training Git architecture">
    <mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ============ SECTION A: WHERE GIT LIVES ============ -->
        <mxCell id="secA" value="A. Where Git lives and how code flows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1660" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Databricks Git folder&lt;/b&gt; (one per developer)&lt;br&gt;/Repos/training/dox_training&lt;br&gt;&lt;br&gt;&#8226; switch / create branch&lt;br&gt;&#8226; edit src/, resources/, notebooks&lt;br&gt;&#8226; commit &amp;amp; push, pull&lt;br&gt;&#8226; own Git credential (GitHub PAT / GitHub app)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="290" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;one-consultants/dox_training&lt;br&gt;&lt;br&gt;&#8226; branch &lt;b&gt;main&lt;/b&gt; (protected, = production)&lt;br&gt;&#8226; branches &lt;b&gt;feature/*&lt;/b&gt; (work in progress)&lt;br&gt;&#8226; tags &lt;b&gt;prod-YYYYMMDD-HHMMSS&lt;/b&gt; (releases)&lt;br&gt;&#8226; .github/workflows/databricks-bundle.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="60" width="320" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;GitHub Actions runner&lt;/b&gt; (ubuntu-latest)&lt;br&gt;&lt;br&gt;&#8226; actions/checkout + databricks/setup-cli&lt;br&gt;&#8226; databricks bundle validate / deploy&lt;br&gt;&#8226; logs in as the &lt;b&gt;service principal&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(environment secrets dev / prod, OAuth M2M)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="60" width="300" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;DEV workspace&lt;/b&gt;&lt;br&gt;/Workspace/Deployments/dox_training&lt;br&gt;[dev] job + pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1290" y="60" width="370" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;PROD workspace&lt;/b&gt;&lt;br&gt;/Workspace/Deployments/dox_training&lt;br&gt;prod job + pipeline (code of a release tag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1290" y="165" width="370" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="ea1" value="push / pull (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ea2" value="events:&lt;br&gt;push, pull_request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ea3" value="feature/* push&lt;br&gt;deploy -t dev" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ea4" value="main + tag&lt;br&gt;deploy -t prod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="a3" target="a5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============ SECTION B: BRANCHING MODEL ============ -->
        <mxCell id="secB" value="B. Branching model (one feature, from branch to release)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="1660" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="lblFeat" value="&lt;b&gt;feature/add-orders-gold&lt;/b&gt;" style="text;html=1;align=right;verticalAlign=middle;fontColor=#1f4e9e;" vertex="1" parent="1">
          <mxGeometry x="30" y="450" width="170" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lblMain" value="&lt;b&gt;main&lt;/b&gt; (protected)" style="text;html=1;align=right;verticalAlign=middle;fontColor=#2d7d32;" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="170" height="30" as="geometry"/>
        </mxCell>

        <!-- commits -->
        <mxCell id="m1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#82b366;strokeColor=#2d7d32;" vertex="1" parent="1">
          <mxGeometry x="230" y="563" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=#1f4e9e;" vertex="1" parent="1">
          <mxGeometry x="400" y="453" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=#1f4e9e;" vertex="1" parent="1">
          <mxGeometry x="640" y="453" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=#1f4e9e;" vertex="1" parent="1">
          <mxGeometry x="900" y="453" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#82b366;strokeColor=#2d7d32;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1180" y="563" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#82b366;strokeColor=#2d7d32;" vertex="1" parent="1">
          <mxGeometry x="1540" y="563" width="24" height="24" as="geometry"/>
        </mxCell>

        <!-- branch lines -->
        <mxCell id="lm12" style="html=1;endArrow=none;strokeWidth=4;strokeColor=#82b366;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lm23" style="html=1;endArrow=none;strokeWidth=4;strokeColor=#82b366;" edge="1" parent="1" source="m2" target="m3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lbr" value="branch off" style="html=1;endArrow=block;strokeWidth=3;strokeColor=#6c8ebf;curved=1;" edge="1" parent="1" source="m1" target="f1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lf12" style="html=1;endArrow=none;strokeWidth=4;strokeColor=#6c8ebf;" edge="1" parent="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lf23" style="html=1;endArrow=none;strokeWidth=4;strokeColor=#6c8ebf;" edge="1" parent="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="lmerge" value="merge (only via approved PR)" style="html=1;endArrow=block;strokeWidth=3;strokeColor=#9673a6;" edge="1" parent="1" source="f3" target="m2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- annotations -->
        <mxCell id="n1" value="&lt;b&gt;&#9312; Create branch&lt;/b&gt;&lt;br&gt;Git folder &#8594; branch menu&lt;br&gt;from latest main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="340" width="185" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;&#9313; Commit &amp;amp; push&lt;/b&gt; (repeat)&lt;br&gt;&#8594; Actions: deploy-dev&lt;br&gt;&#8594; [dev] job in DEV workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="555" y="340" width="195" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;&#9314; Pull request &#8594; main&lt;/b&gt;&lt;br&gt;checks: validate-pr (dev), (prod)&lt;br&gt;+ at least 1 approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="340" width="205" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;&#9315; Merge&lt;/b&gt; &#8594; push to main&lt;br&gt;&#8594; Actions: release-prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1095" y="470" width="195" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;&#9316; tag prod-20261123-101500&lt;/b&gt;&lt;br&gt;checked out &#8594; deploy -t prod" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;fontSize=11;size=0.25;" vertex="1" parent="1">
          <mxGeometry x="1095" y="600" width="195" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="lt1" style="html=1;endArrow=none;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="m2" target="t1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;Next release&lt;/b&gt; = next tag&lt;br&gt;&lt;b&gt;Rollback&lt;/b&gt;: see section D&lt;br&gt;(revert via PR, or redeploy&lt;br&gt;an older prod-* tag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1440" y="470" width="225" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&amp;#10007; No direct push to main &amp;#160;&amp;#160; &amp;#10007; No edits of prod jobs in the UI (next deploy overwrites them) &amp;#160;&amp;#160; &amp;#10003; One feature = one branch = one PR &amp;#160;&amp;#160; &amp;#10003; Delete the branch after merge" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="605" width="840" height="35" as="geometry"/>
        </mxCell>

        <!-- ============ SECTION C: ONE-TIME SETUP ============ -->
        <mxCell id="secC" value="C. One-time setup (admin)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7ec;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="670" width="1660" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Service principal&lt;/b&gt;&lt;br&gt;&lt;br&gt;create sp-dox-training-cicd in DEV and PROD workspace, copy Application ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="715" width="185" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. OAuth secret&lt;/b&gt;&lt;br&gt;&lt;br&gt;SP &#8594; Secrets &#8594; Generate secret (shown once)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="245" y="715" width="185" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Databricks access&lt;/b&gt;&lt;br&gt;&lt;br&gt;CAN_MANAGE on /Workspace/Deployments&lt;br&gt;UC grants on training.default&lt;br&gt;READ FILES on source location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="450" y="715" width="185" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. GitHub environments&lt;/b&gt;&lt;br&gt;&lt;br&gt;dev + prod, each with DATABRICKS_HOST, CLIENT_ID, CLIENT_SECRET" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="655" y="715" width="185" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Protect main&lt;/b&gt;&lt;br&gt;&lt;br&gt;PR required, 1 approval, checks validate-pr (dev/prod), no bypass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="860" y="715" width="185" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. Actions permissions&lt;/b&gt;&lt;br&gt;&lt;br&gt;workflow permissions Read and write (to push prod-* tags)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1065" y="715" width="185" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. Developers connect Git&lt;/b&gt;&lt;br&gt;&lt;br&gt;Settings &#8594; Linked accounts &#8594; GitHub, then clone repo as Git folder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1270" y="715" width="185" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;8. First release&lt;/b&gt;&lt;br&gt;&lt;br&gt;feature branch &#8594; PR &#8594; approve &#8594; merge &#8594; tag + prod deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1475" y="715" width="185" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="es1" style="html=1;endArrow=block;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es2" style="html=1;endArrow=block;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es3" style="html=1;endArrow=block;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es4" style="html=1;endArrow=block;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es5" style="html=1;endArrow=block;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es6" style="html=1;endArrow=block;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es7" style="html=1;endArrow=block;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legendC" value="orange = Databricks admin &#183; yellow = GitHub repo admin &#183; blue = each developer &#183; green = release" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="900" height="30" as="geometry"/>
        </mxCell>
        <!-- ============ SECTION D: ROLLBACK ============ -->
        <mxCell id="secD" value="D. Rollback &#8212; prod release prod-B is broken, go back to prod-A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="990" width="1660" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="lblO1" value="&lt;b&gt;Option 1 &#8212; Revert through a PR (recommended, normal CI/CD)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#2d7d32;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="700" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;Problem in prod&lt;/b&gt;&lt;br&gt;release tag prod-B is bad,&lt;br&gt;prod-A was good" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1045" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;git revert &amp;lt;bad commit&amp;gt;&lt;/b&gt;&lt;br&gt;on a new branch fix/revert-x&lt;br&gt;(Git folder or local Git)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="285" y="1045" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o3" value="&lt;b&gt;Pull request &#8594; main&lt;/b&gt;&lt;br&gt;validate-pr (dev), (prod)&lt;br&gt;+ 1 approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="1045" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o4" value="&lt;b&gt;Merge&lt;/b&gt; &#8594; push to main&lt;br&gt;&#8594; Actions: release-prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="775" y="1045" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="o5" value="&lt;b&gt;New tag prod-C&lt;/b&gt;&lt;br&gt;same code as prod-A&lt;br&gt;&#8594; bundle deploy -t prod" style="shape=offPageConnector;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;size=0.2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1045" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="eo1" style="html=1;endArrow=block;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo2" style="html=1;endArrow=block;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo3" style="html=1;endArrow=block;" edge="1" parent="1" source="o3" target="o4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo4" style="html=1;endArrow=block;" edge="1" parent="1" source="o4" target="o5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="lblO2" value="&lt;b&gt;Option 2 &#8212; Emergency: redeploy the older tag directly (bypasses PR checks)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="1125" width="700" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;git checkout prod-A&lt;/b&gt;&lt;br&gt;(last good release tag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1150" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Log in as the prod service principal&lt;/b&gt;&lt;br&gt;DATABRICKS_HOST / CLIENT_ID / CLIENT_SECRET&lt;br&gt;(only people with access to prod secrets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="346" y="1150" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;databricks bundle validate -t prod&lt;/b&gt;&lt;br&gt;&lt;b&gt;databricks bundle deploy -t prod&lt;/b&gt;&lt;br&gt;prod is back on prod-A in minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="652" y="1150" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Then still do Option 1&lt;/b&gt;&lt;br&gt;main still has the bad code &#8212; the next&lt;br&gt;merge would deploy it again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="958" y="1150" width="282" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ep1" style="html=1;endArrow=block;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ep2" style="html=1;endArrow=block;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ep3" style="html=1;endArrow=block;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ep4" value="follow up" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="o5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1260" y="1185"/>
